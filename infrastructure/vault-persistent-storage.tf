data "terraform_remote_state" "persistent_storage" {
  backend = "s3"

  config = {
    bucket       = "ameen-weather-app-terraform-state-619605943762-us-east-1"
    key          = "persistent-storage/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

locals {
  vault_persistent_volume_id = data.terraform_remote_state.persistent_storage.outputs.volume_ids["vault"]
}

# Reserve the retained Vault EBS volume for the PVC generated by the Vault
# StatefulSet. The legacy awsElasticBlockStore source matches the existing PV;
# EKS transparently migrates it to the EBS CSI driver.
resource "kubernetes_manifest" "vault_data_persistent_volume" {
  manifest = {
    apiVersion = "v1"
    kind       = "PersistentVolume"

    metadata = {
      name = "pvc-d8bafbfa-433c-44fa-af96-8e0c7dec9913"

      labels = {
        "app.kubernetes.io/name"        = "vault"
        "app.kubernetes.io/component"   = "storage"
        "app.kubernetes.io/managed-by"  = "terraform"
        "topology.kubernetes.io/region" = "us-east-1"
        "topology.kubernetes.io/zone"   = "us-east-1b"
      }
    }

    spec = {
      capacity = {
        storage = "10Gi"
      }

      volumeMode                    = "Filesystem"
      accessModes                   = ["ReadWriteOnce"]
      persistentVolumeReclaimPolicy = "Retain"
      storageClassName              = "gp2"

      claimRef = {
        name      = "data-vault-0"
        namespace = kubernetes_namespace_v1.vault.metadata[0].name
      }

      awsElasticBlockStore = {
        volumeID = local.vault_persistent_volume_id
        fsType   = "ext4"
      }

      nodeAffinity = {
        required = {
          nodeSelectorTerms = [
            {
              matchExpressions = [
                {
                  key      = "topology.kubernetes.io/zone"
                  operator = "In"
                  values   = ["us-east-1b"]
                },
                {
                  key      = "topology.kubernetes.io/region"
                  operator = "In"
                  values   = ["us-east-1"]
                }
              ]
            }
          ]
        }
      }
    }
  }

  depends_on = [
    kubernetes_namespace_v1.vault
  ]
}
