# ==========================================
# Terraform
# ==========================================

# Local Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan*
plan*.txt

# Variable files that may contain secrets
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
restore.tfvars

# Keep example variable files
!terraform.tfvars.example
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Do not ignore the provider lock file
!.terraform.lock.hcl


# ==========================================
# Secrets and credentials
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.crt
*.credentials
credentials.json
secrets.json
kubeconfig
kubeconfig.*

# Vault local files
.vault-token
vault-keys*
vault-unseal*
bootstrap-inputs.env


# ==========================================
# Generated and temporary files
# ==========================================

*.log
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
*~

tmp/
temp/
.cache/


# ==========================================
# IDE and editors
# ==========================================

.idea/
.vscode/
*.iml


# ==========================================
# Operating system files
# ==========================================

.DS_Store
Thumbs.db
desktop.ini


# ==========================================
# Python scripts
# ==========================================

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/


# ==========================================
# Local generated archives
# ==========================================

*.zip
*.tar
*.tar.gz

# AWS credentials
.aws/
credentials

